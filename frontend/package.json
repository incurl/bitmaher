{
  "name": "bitmaher-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.0.1",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "vue-tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint src/ --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,vue,css,json}\""
  },
  "dependencies": {
    "@formatjs/intl-localematcher": "^0.9.0",
    "@formkit/auto-animate": "^0.10.0",
    "@material/material-color-utilities": "^0.4.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^14.3.0",
    "@wailsio/runtime": "^3.0.0",
    "dompurify": "^3.4.17",
    "lodash-es": "^4.18.1",
    "marked": "^18.1.2",
    "marked-alert": "^2.1.2",
    "naive-ui": "^2.44.1",
    "picomatch": "^4.0.7",
    "pinia": "^3.0.4",
    "sanitize-filename": "^1.6.4",
    "sortablejs": "^1.15.7",
    "vue": "^3.5.35",
    "vue-i18n": "^11.4.5",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@intlify/unplugin-vue-i18n": "^11.2.3",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^24.13.1",
    "@types/picomatch": "^4.0.3",
    "@types/sortablejs": "^1.15.9",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.7.0",
    "happy-dom": "^15.11.7",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.9",
    "vue-tsc": "^2.2.0"
  }
}
