{
  "compilerOptions": {
    "target": "ES2021",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "lib": ["ES2021", "DOM", "DOM.Iterable"],
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "preserve",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
        "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./src/shared/*"],
      "@tauri-apps/api/core": ["./src/platform/core.ts"],
      "@tauri-apps/api/event": ["./src/platform/event.ts"],
      "@tauri-apps/api/window": ["./src/platform/window.ts"],
      "@tauri-apps/api/webviewWindow": ["./src/platform/window.ts"],
      "@tauri-apps/api/webview": ["./src/platform/webview.ts"],
      "@tauri-apps/api/path": ["./src/platform/path.ts"],
      "@tauri-apps/api/app": ["./src/platform/app.ts"],
      "@tauri-apps/plugin-dialog": ["./src/platform/dialog.ts"],
      "@tauri-apps/plugin-opener": ["./src/platform/opener.ts"],
      "@tauri-apps/plugin-process": ["./src/platform/process.ts"],
      "@tauri-apps/plugin-store": ["./src/platform/store.ts"],
      "@tauri-apps/plugin-os": ["./src/platform/os.ts"],
      "@tauri-apps/plugin-fs": ["./src/platform/fs.ts"],
      "@tauri-apps/plugin-clipboard-manager": ["./src/platform/clipboard.ts"],
      "@tauri-apps/plugin-log": ["./src/platform/logger.ts"],
      "tauri-plugin-locale-api": ["./src/platform/locale.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "src/**/*.vue"],
  "exclude": ["src/bindings/**"]
}
